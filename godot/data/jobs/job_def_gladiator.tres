transition_level_override = 40
basic_combo = ExtResource("3")
granted_weapon = null
skill_slot_1 = ExtResource("4")
skill_slot_2 = ExtResource("5")
skill_slot_3 = ExtResource("6")
skill_slot_4 = ExtResource("7")
skill_slot_q = ExtResource("8")
skill_slot_e = ExtResource("9")
